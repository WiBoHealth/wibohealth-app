{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/scanner.html",
      "destination": "/boodi.html",
      "permanent": true
    },
    {
      "source": "/articles.html",
      "destination": "/#articles",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/#articles",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/boodi.html",
      "permanent": true
    },
    {
      "source": "/my-articles.html",
      "destination": "/#articles",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path((?!foods/|supplements/|articles/|diabetes|bmi-calculator|tdee-calculator|water-calculator|whtr-calculator).*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nl",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nl/:path((?!foods/|supplements/|articles/|diabetes|bmi-calculator|tdee-calculator|water-calculator|whtr-calculator).*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sv",
      "destination": "/sv/index.html",
      "permanent": true
    },
    {
      "source": "/sv/:path((?!index\\.html$|diabetes|articles/|dr-wassim-habib\\.html$|om-oss\\.html$|integritetspolicy\\.html$|anvandarvillkor\\.html$|medicinsk-ansvarsfriskrivning\\.html$|kontakt\\.html$|radera-konto\\.html$).*)",
      "destination": "/sv/index.html",
      "permanent": false
    },
    {
      "source": "/:proto(https?)\\:/:host(wibohealth\\.com|www\\.wibohealth\\.com)/:path+",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/:proto(https?)\\::rest(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}